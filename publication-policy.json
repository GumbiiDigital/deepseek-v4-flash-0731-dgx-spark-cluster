{
  "schema_version": 1,
  "manifest": "PUBLICATION_MANIFEST.sha256",
  "publication_roots": [
    "README.md",
    "NOTICE.md",
    "LICENSE",
    "COPYRIGHT.md",
    "THIRD_PARTY_NOTICES.md",
    "publication-policy.json",
    "PUBLICATION_MANIFEST.sha256",
    "docs",
    "data",
    "media",
    "scripts"
  ],
  "exclude_dirs": [
    ".git",
    "__pycache__"
  ],
  "forbidden_path_regexes": [
    "(?i)(?:^|/)(?:private-evidence|raw-logs?|raw-captures?|ssh|network-config)(?:/|$)",
    "(?i)(?:^|/)(?:\\.env|id_rsa|id_ed25519|known_hosts)$"
  ],
  "forbidden_text_regexes": [
    {
      "id": "mac-home-path",
      "pattern": "/Users/[A-Za-z0-9._-]+/"
    },
    {
      "id": "linux-home-path",
      "pattern": "/(?:home|root)/[^\\s]+"
    },
    {
      "id": "private-ipv4",
      "pattern": "(?<![0-9])(?:10\\.[0-9]{1,3}\\.[0-9]{1,3}\\.[0-9]{1,3}|192\\.168\\.[0-9]{1,3}\\.[0-9]{1,3}|172\\.(?:1[6-9]|2[0-9]|3[01])\\.[0-9]{1,3}\\.[0-9]{1,3}|100\\.(?:6[4-9]|[7-9][0-9]|1[01][0-9]|12[0-7])\\.[0-9]{1,3}\\.[0-9]{1,3})(?![0-9])"
    },
    {
      "id": "host-identity",
      "pattern": "(?i)\\bspark[1-8](?:-lan|-bypass)?\\b"
    },
    {
      "id": "ssh-material",
      "pattern": "(?i)(?:IdentityFile|\\.ssh/|id_rsa|id_ed25519|[^/\\s]+\\.key)"
    },
    {
      "id": "generated-text-fields",
      "pattern": "\"(?:generated_texts|snippet)\"\\s*:"
    },
    {
      "id": "secret-shapes",
      "pattern": "(?:-----BEGIN (?:RSA |OPENSSH |EC |DSA )?PRIVATE KEY-----|AKIA[0-9A-Z]{16}|gh[pousr]_[A-Za-z0-9]{20,}|hf_[A-Za-z0-9]{20,}|sk-[A-Za-z0-9_-]{20,}|xox[baprs]-[A-Za-z0-9-]{10,})"
    }
  ],
  "stable_pdfs": [],
  "pdf": {
    "require_tagged": false,
    "require_unencrypted": true,
    "forbid_javascript": true,
    "forbid_attachments": true,
    "minimum_pages": 1
  },
  "publication_boundary": {
    "repository": "GumbiiDigital/deepseek-v4-flash-0731-dgx-spark-cluster",
    "local_preparation_only": false,
    "remote_push_authorized": true,
    "raw_private_archive_included": false,
    "rights_status": "open-source-mit",
    "open_source_license_granted": true
  }
}
